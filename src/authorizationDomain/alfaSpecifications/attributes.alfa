namespace acme {
    attribute adviceText {
        id = "acme.adviceText"
        type = string
        category = environmentCat
    }
}
namespace user {
    attribute role {
        id = "user.role"
        type = string
        category = subjectCat
    }
    attribute location {
        id = "user.location"
        type = string
        category = subjectCat
    }
     attribute identity {
            id = "user.identity"
            type = string
            category = subjectCat
        }
}
namespace resource {
    attribute location {
        id = "resource.location"
        type = string
        category = resourceCat
    }
    attribute identity {
        id = "resource.identity"
        type = string
        category = resourceCat
    }
}
namespace Attributes {
    attribute currentDateTime {
        id = "urn:oasis:names:tc:xacml:1.0:environment:current-dateTime"
        category = environmentCat
        type = dateTime
    }

    attribute currentDate {
        id = "urn:oasis:names:tc:xacml:1.0:environment:current-date"
        category = environmentCat
        type = date
    }

    attribute currentTime {
        id = "urn:oasis:names:tc:xacml:1.0:environment:current-time"
